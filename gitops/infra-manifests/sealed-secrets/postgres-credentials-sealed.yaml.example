# This is a PLACEHOLDER showing the shape of a real SealedSecret. You must
# generate the real encryptedData via `kubeseal` against your own cluster's
# controller — a copy-pasted example here would not decrypt anywhere else.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: postgres-credentials
  namespace: streamflix
spec:
  encryptedData:
    username: <REPLACE-WITH-REAL-OUTPUT-FROM-KUBESEAL>
    password: <REPLACE-WITH-REAL-OUTPUT-FROM-KUBESEAL>
  template:
    metadata:
      name: postgres-credentials
      namespace: streamflix
    type: Opaque
